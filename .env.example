# Docker Compose (PostgreSQL & Qdrant)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=huce_kms
POSTGRES_PORT=5432

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/huce_kms

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Security & Auth
SECRET_KEY=huce-kms-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
DEBUG=True

# Gemini AI (LLM & Embedding)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=text-embedding-004
VECTOR_DIMENSION=768

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
