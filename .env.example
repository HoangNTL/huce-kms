# Docker Compose (PostgreSQL, Qdrant & MinIO)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=huce_kms
POSTGRES_PORT=5432

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Object Storage (MinIO / S3)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_NAME=huce-kms-documents
MINIO_URL_EXPIRY_SECONDS=3600
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/huce_kms

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Security & Auth
SECRET_KEY=huce-kms-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
DEBUG=True

# AI Multi-Provider Configuration (Fallback Order)
GENERATION_PROVIDERS=gemini,groq,openrouter
GENERATION_MAX_RETRIES=2
GENERATION_TIMEOUT=30

# Gemini AI (LLM & Canonical Embedding)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Groq AI (Ultra-fast LLM fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter AI (Multi-model LLM gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Vision OCR Multi-Provider Fallback (for scanned PDFs)
OCR_PROVIDERS=gemini,groq,openrouter
OCR_GEMINI_MODEL=gemini-2.5-flash
OCR_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
OCR_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OCR_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OCR_MAX_CONCURRENCY=2
OCR_MAX_RETRIES=3

# Embedding Providers Configuration (Strict Canonical Space)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-001
VECTOR_DIMENSION=768

# Voyage AI (Optional alternative embedding provider)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Jina AI (Optional alternative embedding provider)
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
