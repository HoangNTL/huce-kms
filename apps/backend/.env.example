# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/huce_kms

# Security & Auth
SECRET_KEY=huce-kms-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
DEBUG=True

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# AI Multi-Provider Configuration (Fallback Order)
GENERATION_PROVIDERS=gemini,groq,openrouter
GENERATION_MAX_RETRIES=2
GENERATION_TIMEOUT=30

# Gemini AI (LLM & Canonical Embedding)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Groq AI (Ultra-fast LLM fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter AI (Multi-model LLM gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Embedding Providers Configuration (Strict Canonical Space)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-001
VECTOR_DIMENSION=768

# Voyage AI (Optional alternative embedding provider)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# Jina AI (Optional alternative embedding provider)
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
